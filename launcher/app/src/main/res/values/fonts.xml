<?xml version="1.0" encoding="utf-8"?>
<!-- This fork: Cormorant Garamond, the serif of the frame-glass gallery look (Outfit stays in res/font for an
     easy way back). The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/cormorant_regular</string>
    <string name="font_regular" translatable="false">@font/cormorant_regular</string>
    <string name="font_light" translatable="false">@font/cormorant_light</string>
    <string name="font_extralight" translatable="false">@font/cormorant_extralight</string>
    <string name="font_medium" translatable="false">@font/cormorant_medium</string>
</resources>
